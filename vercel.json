{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?consultation\\.voila\\.sg"
        }
      ],
      "destination": "https://www.voila.sg/contact#book",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reviews-sync",
      "schedule": "0 1 * * *"
    }
  ],
  "cleanUrls": true
}
