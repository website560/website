{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reviews-sync",
      "schedule": "0 1 * * *"
    }
  ],
  "cleanUrls": true
}
